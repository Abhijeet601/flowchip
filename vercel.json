{
  "version": 2,
  "builds": [
    {
      "src": "**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "^/home\\.html$",
      "status": 301,
      "dest": "/"
    },
    {
      "src": "^/index\\.html$",
      "status": 301,
      "dest": "/"
    },
    {
      "src": "^/(.+)\\.html$",
      "status": 301,
      "dest": "/$1"
    },
    {
      "src": "^/home/?$",
      "status": 301,
      "dest": "/"
    },
    {
      "src": "^/([^/.]+)/?$",
      "dest": "/$1.html"
    },
    {
      "src": "/",
      "dest": "/home.html"
    }
  ]
}
